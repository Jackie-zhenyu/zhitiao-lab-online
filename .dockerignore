# Only application source and the public example catalogue enter the build context.
*
!Dockerfile
!requirements.lock.txt
!app.py
!core/
!core/*.py
!ui/
!ui/*.py
!agent/
!agent/*.py
!reports/
!reports/*.py
!projects/
!projects/*.py
!examples/
!examples/*.py
!examples/README.md
!examples/CLOSED_LOOP.md
!examples/data/
!examples/data/manifest.json
!examples/data/first_order_step.csv
!examples/data/irregular_sampling.csv
!examples/data/quality_issues.csv
!examples/closed_loop_data/
!examples/closed_loop_data/manifest.json
!examples/closed_loop_data/closed_loop_pi_a.csv
!examples/closed_loop_data/closed_loop_pi_b.csv
!.streamlit/
!.streamlit/config.toml

**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/secrets.toml
**/*.log
