# 可选AI配置。复制到项目根目录 .env 后只在本地填写真实密钥。
# 此文件中的密钥必须保持为空；本地分析不需要任何配置。
LLM_PROVIDER=qwen
# 北京接口示例；也可用控制台业务空间对应的官方地域地址，见配置文档。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文档已核实北京 qwen-plus 支持 Function Calling；按账号/地域核对后可更换。
LLM_MODEL=qwen-plus
LLM_API_KEY=

# 以下均可选；次数、超时与摘要范围在发送前展示。
LLM_MAX_ROUNDS=6
LLM_MAX_TOOL_CALLS=8
LLM_REQUEST_TIMEOUT_S=30
LLM_TOTAL_TIMEOUT_S=90
LLM_MAX_RETRIES=1
LLM_MAX_CORRECTIONS=1
LLM_MAX_HISTORY_TURNS=4
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_CONTEXT_CHARS=30000
LLM_MAX_TOOL_RESULT_CHARS=12000
LLM_MAX_EVENTS=20
